---
const { url, title, description, pubDate, tags, wide = false } = Astro.props
const postHref = url.startsWith('/') ? url : `/${url}`
---

<article
  class:list={[
    'group flex h-full min-h-[245px] flex-col border border-black/10 bg-white/20 p-7 transition-colors duration-200 hover:border-accentColor/70 dark:border-white/10 dark:bg-white/[0.025] dark:hover:border-accentColor/70 w500:min-h-0 w500:p-5',
    wide && 'md:min-h-[275px]'
  ]}
>
  <div class="flex items-start justify-between gap-5">
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {
        tags.map((tag: string) => (
          <a
            class="text-xs font-medium text-accentColor hover:underline"
            href={`/tags/${tag}`}
          >
            #{tag}
          </a>
        ))
      }
    </div>

    <span
      class="translate-x-0 text-xl leading-none text-accentColor transition-transform duration-200 group-hover:translate-x-1"
      aria-hidden="true"
    >
      →
    </span>
  </div>

  <div class="mt-8 flex flex-1 flex-col w500:mt-6">
    <a class="w-fit" href={postHref}>
      <h2
        transition:name={`${title}-${pubDate}`}
        class="text-2xl font-medium leading-snug text-lightModeText transition-colors duration-200 group-hover:text-accentColor dark:text-darkModeText w500:text-xl"
      >
        {title}
      </h2>
    </a>

    <p
      class:list={[
        'post-description mt-4 max-w-[58ch] text-sm leading-7 text-black/60 dark:text-white/60',
        wide ? 'post-description--wide' : 'post-description--compact'
      ]}
    >
      {description}
    </p>

    <div
      class="mt-auto border-t border-black/10 pt-5 text-xs font-medium uppercase text-black/55 dark:border-white/10 dark:text-white/55 w500:mt-6"
    >
      {pubDate}
    </div>
  </div>
</article>

<style>
  .post-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .post-description--wide {
    -webkit-line-clamp: 3;
  }

  .post-description--compact {
    -webkit-line-clamp: 2;
  }
</style>
